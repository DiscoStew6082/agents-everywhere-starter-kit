{
  "name": "agents-everywhere-starter-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starter kit for the Agents, Everywhere: Bots, Channels & More global hackathon.",
  "license": "MIT",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "workspaces": [
    "packages/*",
    "apps/channel",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:slack": "npm run dev --workspace channel",
    "channel:status": "npx copilotkit@latest channels status --json",
    "channel:setup": "npx copilotkit@latest channels setup",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev --workspace web",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run typecheck && npm test"
  },
  "overrides": {
    "@ag-ui/client": "0.0.59",
    "@graphql-tools/utils@^12": "12.0.2",
    "@hono/node-server@^1": "1.19.18",
    "@hono/node-server@^2": "2.1.6",
    "@modelcontextprotocol/client@^2": "2.3.0",
    "@opentelemetry/core@^2": "2.8.0",
    "@opentelemetry/resources@^2": "2.8.0",
    "@opentelemetry/sdk-trace-base@^2": "2.8.0",
    "body-parser@^1": "1.20.9",
    "body-parser@^2": "2.4.0",
    "dompurify": "3.4.17",
    "fast-uri": "3.1.9",
    "follow-redirects": "1.16.2",
    "hono": "4.13.16",
    "ip-address": "10.7.4",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "undici@^6": "6.29.1",
    "zod@^4": "4.6.6",
    "@modelcontextprotocol/sdk@^1": "1.32.0",
    "next": {
      "postcss": "8.5.23"
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
