{
  "name": "react-native-template",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "bundle:ios": "expo export --platform ios --output-dir dist/ios",
    "bundle:android": "expo export --platform android --output-dir dist/android",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@copilotkit/react-native": "1.70.1",
    "@types/react": "~19.1.0",
    "expo": "~54.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-get-random-values": "~1.11.0",
    "react-native-markdown-renderer": "4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.0"
  },
  "overrides": {
    "@hono/node-server@^2": "2.1.6",
    "@modelcontextprotocol/sdk": "1.32.0",
    "body-parser": "2.4.0",
    "brace-expansion@^1": "1.1.21",
    "brace-expansion@^2": "2.1.7",
    "brace-expansion@^5": "5.0.12",
    "compression": "1.8.2",
    "dompurify": "3.4.17",
    "fast-uri": "3.1.9",
    "hono": "4.13.16",
    "ip-address": "10.7.4",
    "markdown-it": "14.3.3",
    "node-forge": "1.4.3",
    "postcss": "8.5.23",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "shell-quote": "1.11.0",
    "source-map-js": "1.2.2",
    "undici@^6": "6.29.1",
    "zod@^4": "$zod"
  }
}
